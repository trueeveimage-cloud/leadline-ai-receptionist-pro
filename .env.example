SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Deal notifications and transactional email sender identity.
# The sender domain must be verified with the email provider before production send.
LEADMAP_OWNER_EMAIL=hello@leadmap.se
LEADMAP_EMAIL_FROM=Leadmap <hello@leadmap.se>
LEADMAP_EMAIL_SENDER_DOMAIN=notify.leadmap.se
LEADMAP_DKIM_SELECTOR=
LOVABLE_API_KEY=
LOVABLE_SEND_URL=

# Required before paid advertising is enabled.
VITE_GOOGLE_TAG_ID=
VITE_GOOGLE_ADS_AUDIT_LABEL=
VITE_GOOGLE_ADS_DEMO_LABEL=

# Google Calendar OAuth. The refresh token must remain server-side.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Google Data Manager API for consented qualified_lead and pilot_won uploads.
# Keep OAuth credentials server-side. Conversion action IDs must be UPLOAD_CLICKS actions.
GOOGLE_DATA_MANAGER_CLIENT_ID=
GOOGLE_DATA_MANAGER_CLIENT_SECRET=
GOOGLE_DATA_MANAGER_REFRESH_TOKEN=
GOOGLE_DATA_MANAGER_PROJECT_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_QUALIFIED_LEAD_ACTION_ID=
GOOGLE_ADS_PILOT_WON_ACTION_ID=

# Retell web demo. API keys and agent IDs must remain server-side.
RETELL_API_KEY=
RETELL_WEB_DEMO_AGENT_ID_SV=
VOICE_DEMO_RATE_LIMIT_SALT=

# Publish verified company details; do not invent these values.
VITE_LEADMAP_LEGAL_NAME=
VITE_LEADMAP_ORG_NUMBER=
VITE_LEADMAP_BUSINESS_ADDRESS=

# Commercial guardrails. These are internal planning inputs, not public claims.
# Set the real blended provider + telephony cost before signing a customer.
LEADMAP_BLENDED_COST_SEK_PER_MINUTE=
LEADMAP_SHARED_COST_SEK_PER_CUSTOMER=300
LEADMAP_TARGET_GROSS_MARGIN_PERCENT=70
